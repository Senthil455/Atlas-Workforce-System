# Auth Service
PORT=8010
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_DEFAULT_PASSWORD=ChangeMe123!
POSTGRES_URL=postgresql://atlas_user:atlas_password@postgres:5432/atlas_db
POSTGRES_SSL=false
ALLOWED_ORIGINS=http://localhost:3000

# Audit Service Integration (x-internal-auth JWT with audit-writer audience)
AUDIT_SERVICE_URL=http://audit-compliance-service:8011
INTERNAL_JWT_SECRET=

# SAML Configuration
SAML_IDP_SSO_URL=https://idp.example.com/sso
SAML_IDP_ENTITY_ID=https://idp.example.com/metadata
SAML_IDP_CERT=

# MFA Step-up Configuration
MFA_STEPUP_SECRET=change-me-to-a-long-random-string-for-mfa-stepup

# OAuth Configuration
OAUTH_ENCRYPTION_KEY=change-me-to-a-long-random-string-for-oauth-encryption

# SCIM Configuration
SCIM_API_KEY=change-scim-api-key-in-production
# Per-tenant provisioning keys. Legacy SCIM_API_KEY is scoped to the default tenant only.
# Format: tenant-a:key-a,tenant-b:key-b  (or JSON object)
SCIM_API_KEYS=
